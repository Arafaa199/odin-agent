# Every environment variable the code reads. Placeholders only.
# Nothing loads this file automatically: use `set -a; . ./.env; set +a`
# or a systemd EnvironmentFile=.

# --- Config file locations (default: config/<name>.yaml, else the .example.yaml)
ODIN_SETTINGS=
ODIN_HOSTS=
ODIN_KNOWN_SERVICES=

# --- LLM routing
OPENROUTER_API_KEY=sk-or-replace-me
OPENROUTER_REFERER=https://example.com/odin-agent
CLAUDE_MODEL=opus

# --- Audit log (ingest refuses to run without the key)
ODIN_AUDIT_KEY=replace-with-a-long-random-string
ODIN_AUDIT_LOG=~/.local/state/odin/audit.jsonl

# --- Ingest
ODIN_TIMEZONE=UTC
TASK_WEBHOOK_URL=https://tasks.example.com/webhook/task-intake
TASK_WEBHOOK_CA=

# --- Event intake and agent memory (HTTP)
INTAKE_URL=http://localhost:8100
INTAKE_KEY=replace-me

# --- Postgres (traces, approvals, freshness). Unset password = skip DB writes.
ODIN_DB_HOST=localhost
ODIN_DB_PORT=5432
ODIN_DB_NAME=odin
ODIN_DB_USER=odin
ODIN_DB_PASSWORD=

# --- Notifications
IMESSAGE_BRIDGE_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
NOTIFY_DIR=~/odin-notifications
NOTIFY_SSH_HOST=
ODIN_SSH_HOST=laptop
ODIN_SHIM_URL=http://localhost:3340/send

# --- Watchdog
ODIN_AGENT_DIR=~/.local/state/odin/agent
WATCHDOG_STATE_PATH=~/.odin/.watchdog-state.json
WATCHDOG_HC_URL=https://hc.example.com/ping/replace-me
WATCHDOG_HC_CA=
SEARCH_WORKER_UNIT=search-worker.service

# --- Health probe
HEALTHPROBE_STATE_DIR=~/.odin/.healthprobe
RECALL_PROBE_KEY=

# --- launchd monitor (macOS)
LAUNCHD_MONITOR_STATE=~/.local/state/launchd-monitor-state.json
LAUNCHD_MONITOR_KEEPALIVE=com.example.odin-node,com.example.imessage-bridge
LAUNCHD_MONITOR_INTERVAL=com.example.transaction-import,com.example.mail-intel
LAUNCHD_MONITOR_DRYRUN=0

# --- Home Assistant control
HA_URL=http://localhost:8123
HA_TOKEN=
